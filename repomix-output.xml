            return {
                "title": "There's Nothing Holdin' Me Back",
                "artist": "Shawn Mendes",
                "artist_name": "Shawn Mendes",
                "album": "Illuminate",
                "album_title": "Illuminate",
                "recording_id": target_mbid,
                "length": 199400,
                "duration_ms": 199400,
