import { writable, get } from 'svelte/store';
function createPlayerStore() {
  const _store = writable({
    isPlaying:    false,
    currentTrack: null,
    streamUrl:    null,
    playCommand:  null,
    seekTo:       null,
    volume:       1.0,
    currentTime:  0,
    duration:     0,
    showPlayer:   false,
  });
  const { subscribe, set, update } = _store;
  function playTrack(url, trackMetadata) {
    update(s => ({
      ...s,
      streamUrl:    url,
      currentTrack: trackMetadata,
      playCommand:  null,
      seekTo:       null,
      isPlaying:    false,
      currentTime:  0,
      duration:     0,
      showPlayer:   true,
    }));
  }
  function pause() {
    update(s => ({ ...s, playCommand: 'pause', isPlaying: false }));
  }
  function resume() {
    update(s => ({ ...s, playCommand: 'play', isPlaying: true }));
  }
  function stop() {
    const { volume } = get(_store);
    set({
      isPlaying:    false,
      currentTrack: null,
      streamUrl:    null,
      playCommand:  'stop',
      seekTo:       null,
      volume,
      currentTime:  0,
      duration:     0,
      showPlayer:   false,
    });
  }
  function seek(time) {
    if (isFinite(time)) {
      update(s => ({ ...s, seekTo: time, currentTime: time }));
    }
  }
  function clearSeekTarget() {
    update(s => ({ ...s, seekTo: null }));
  }
  function clearPlayCommand() {
    update(s => ({ ...s, playCommand: null }));
  }
  function setVolume(level) {
    const volume = Math.max(0, Math.min(1, level));
    update(s => ({ ...s, volume }));
  }
  async function play(track) {
    if (!track) { resume(); return; }
    if (!track.media || track.media.length === 0) {
      if (track.sync_id) {
        try {
          const { default: apiClient } = await import('../api/client');
          const res = await apiClient.get(`/core/tracks/${encodeURIComponent(track.sync_id)}?detail=true`);
          if (res.data && res.data.media) {
            track = { ...track, media: res.data.media };
          }
        } catch (err) {
          console.error("[Player JIT] Failed to hydrate track media:", err);
        }
      }
    }
    playTrack(`/api/v1/core/library/stream/${track.id}`, track);
  }
  function toggle() {
    if (get(_store).isPlaying) pause(); else resume();
  }
  function getStreamUrl(trackId) {
    return `/api/v1/core/library/stream/${trackId}`;
  }
  return {
    subscribe,
    update,
    playTrack,
    pause,
    resume,
    stop,
    seek,
    clearSeekTarget,
    clearPlayCommand,
    setVolume,
    play,
    toggle,
    getStreamUrl,
  };
}
