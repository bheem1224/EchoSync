        assert sanitize_query_for_wire("W&W") == "W W"
        assert sanitize_query_for_wire("AC/DC") == "AC DC"
        assert (
            sanitize_query_for_wire("Song (Original Mix) [2024]")
            == "Song Original Mix 2024"
        )
