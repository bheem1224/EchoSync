                    max_per_artist = 12
                logger.info(f"{decade}s has {unique_artists} unique artists - using limits: {max_per_album} per album, {max_per_artist} per artist")
                tracks_by_album = {}
                tracks_by_artist = {}
                diverse_tracks = []
                for track in all_tracks:
                    album = track['album_name']
