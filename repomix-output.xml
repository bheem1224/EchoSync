PROFILE_DOWNLOAD_SEARCH = DownloadSearchProfile()
PROFILE_LIBRARY_IMPORT = LibraryImportProfile()
PROFILE_AUTO_IMPORT_STRICT = AutoImportStrictProfile()
PROFILE_DUPLICATE_DETECTION = DuplicateDetectionProfile()
