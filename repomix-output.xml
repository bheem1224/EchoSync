        "memoryview",
        "input",
    }
)
_FORBIDDEN_MODULE_CALLS: dict = {
    "os": frozenset(
        {
            "system",
            "popen",
            "fdopen",
            "kill",
            "execve",
            "spawn",
            "remove",
            "unlink",
            "rename",
            "rmdir",
            "mkdir",
            "chmod",
            "chown",
            "symlink",
            "link",
            "environ",
        }
    ),
    "shutil": frozenset({"move", "copy", "rmtree"}),
    "importlib": frozenset({"import_module", "reload"}),
    "builtins": frozenset(
        {
            "eval",
            "exec",
            "getattr",
            "setattr",
            "delattr",
            "open",
            "compile",
            "__import__",
            "globals",
