class _OstSafeMatcher:
    def match(self, text: str):
        if not text:
            return None
        s = re.sub(r"[\s\-_]+", "", str(text).lower())
        if not s:
            return True
        n = len(s)
        dp = [False] * (n + 1)
        dp[0] = True
        for i in range(n):
            if not dp[i]:
                continue
            if s[i].isdigit():
                dp[i + 1] = True
            for w in _OST_SAFE_WORDS:
                if s.startswith(w, i):
                    dp[i + len(w)] = True
        return True if dp[n] else None
