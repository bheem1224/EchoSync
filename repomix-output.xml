<file path="src/database/working_db.rs">
use rusqlite::{Connection, Result as SqlResult};
use std::path::Path;
use std::sync::Mutex;
use std::time::Duration;
pub struct WorkingDbPool {
    db_path: String,
    conn: Mutex<Connection>,
}
impl WorkingDbPool {
    pub fn new<P: AsRef<Path>>(path: P) -> SqlResult<Self> {
        let db_path = path.as_ref().to_string_lossy().to_string();
        let conn = Connection::open(&path)?;
        conn.busy_timeout(Duration::from_millis(5000))?;
        let _ = conn.pragma_update(None, "journal_mode", "WAL");
        let _ = conn.pragma_update(None, "synchronous", "NORMAL");
        Ok(WorkingDbPool {
            db_path,
            conn: Mutex::new(conn),
        })
    }
    pub fn db_path(&self) -> &str {
        &self.db_path
    }
    pub fn execute<F, R>(&self, f: F) -> SqlResult<R>
    where
        F: FnOnce(&Connection) -> SqlResult<R>,
    {
        let conn = self.conn.lock().unwrap();
        f(&*conn)
    }
}
</file>

<file path="src/file_handling/fs_ops.rs">
use std::fs;
use std::io::{self, ErrorKind};
use std::path::Path;
pub struct FsOperations;
impl FsOperations {
    pub fn safe_move<P: AsRef<Path>, Q: AsRef<Path>>(src: P, dst: Q) -> io::Result<()> {
        let src_path = src.as_ref();
        let dst_path = dst.as_ref();
        if let Some(parent) = dst_path.parent() {
            if !parent.exists() {
                fs::create_dir_all(parent)?;
            }
        }
        match fs::rename(src_path, dst_path) {
            Ok(()) => Ok(()),
            Err(err) => {
                let is_exdev = err.kind() == ErrorKind::CrossesDevices
                    || err.raw_os_error() == Some(18);
                if is_exdev {
                    fs::copy(src_path, dst_path)?;
                    fs::remove_file(src_path)?;
                    Ok(())
                } else {
                    Err(err)
                }
            }
        }
    }
    pub fn copy_file<P: AsRef<Path>, Q: AsRef<Path>>(src: P, dst: Q) -> io::Result<u64> {
        let src_path = src.as_ref();
        let dst_path = dst.as_ref();
        if let Some(parent) = dst_path.parent() {
            if !parent.exists() {
                fs::create_dir_all(parent)?;
            }
        }
        fs::copy(src_path, dst_path)
    }
    pub fn delete_file<P: AsRef<Path>>(path: P) -> io::Result<()> {
        let p = path.as_ref();
        if p.exists() {
            fs::remove_file(p)?;
        }
        Ok(())
    }
}
