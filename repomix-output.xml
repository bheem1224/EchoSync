                working_mode = "rw" if write_access else "ro"
                if os.path.exists("/data/working.db"):
                    cursor.execute(f"ATTACH DATABASE 'file:/data/working.db?mode={working_mode}' AS working")
            except Exception:
                pass
            finally:
                cursor.close()
        return engine
