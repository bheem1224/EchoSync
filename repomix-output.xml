                                    _best_artist_name = source_track.artist_name
                                    logger.debug(
                                        "Multi-Artist (safe containment): Spotify '%s' found inside "
                                        "local '%s' → artist_score=1.0",
                                        source_track.artist_name,
                                        _best_artist_name,
