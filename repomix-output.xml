    f_unenhanced.write_bytes(b"dummy audio b")
    import datetime
    shared_chromaprint = (
        "shared_chromaprint_daft_punk_get_lucky_1234567890_canonical_sample"
    )
    with db.session_scope() as session:
        artist = Artist(name="Daft Punk")
        session.add(artist)
        session.flush()
        album = Album(
            title="Random Access Memories",
