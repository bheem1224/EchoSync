        clean_path = raw_clean.replace("\\", "/")
        parts = [p.strip() for p in clean_path.split("/") if p.strip()]
        dir_artist = None
        dir_album = None
        if len(parts) >= 3:
            dir_artist = parts[-3]
            dir_album = parts[-2]
            filename_part = parts[-1]
        elif len(parts) == 2:
            dir_artist = parts[-2]
            filename_part = parts[-1]
        else:
            filename_part = parts[0]
