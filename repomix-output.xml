    if PluginRegistry.is_plugin_disabled('plex'):
        return JSONResponse(content={'settings': {}}, status_code=200)
    try:
        base_url = sdk.config.get('plex.base_url', '')
        server_name = sdk.config.get('plex.server_name', '')
