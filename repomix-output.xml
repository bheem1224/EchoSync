                "title": "Where Were You in the Morning?",
                "artist": "Shawn Mendes",
                "duration": 199.4,
                "score": 0.94,
            },
        ],
        "mbids": [target_mbid, "2aeeb920-571d-406c-8e96-21562753cebc"],
        "score": 0.98,
    }
    mb_calls = []
