import logging
from dataclasses import dataclass, field
from datetime import datetime
from typing import (
    Any,
)
from core.tiered_logger import tiered_logger
class Artist:
    pass
class Album:
    parent_id: str | None = None
class Track:
    parent_id: str | None = None
    grandparent_id: str | None = None
@dataclass
class ContentChanges:
    artists: list[Artist] = field(default_factory=list)
    albums: list[Album] = field(default_factory=list)
    tracks: list[Track] = field(default_factory=list)
    last_checked: datetime | None = None
    full_refresh: bool = False
    metadata: dict[str, Any] = field(default_factory=dict)
    def albums_for_artist(self, artist_id: str) -> list[Album]:
        tiered_logger.log(
            "debug", logging.INFO, f"Filtering albums for artist_id: {artist_id}"
        )
        return [
            a for a in self.albums if str(getattr(a, "parent_id", None)) == artist_id
        ]
    def tracks_for_album(self, album_id: str) -> list[Track]:
        tiered_logger.log(
            "debug", logging.INFO, f"Filtering tracks for album_id: {album_id}"
        )
        return [
            t for t in self.tracks if str(getattr(t, "parent_id", None)) == album_id
        ]
    def tracks_for_artist(self, artist_id: str) -> list[Track]:
        tiered_logger.log(
            "debug", logging.INFO, f"Filtering tracks for artist_id: {artist_id}"
        )
        return [
            t
            for t in self.tracks
            if str(getattr(t, "grandparent_id", None)) == artist_id
        ]
    @property
    def total_items(self) -> int:
        total = len(self.artists) + len(self.albums) + len(self.tracks)
        tiered_logger.log("debug", logging.INFO, f"Total items calculated: {total}")
        return total
    @property
    def is_empty(self) -> bool:
        """Check if no content changes detected"""
        empty = self.total_items == 0
        tiered_logger.log("debug", logging.INFO, f"ContentChanges is_empty: {empty}")
        return empty
    def __str__(self) -> str:
        return (
            f"ContentChanges(artists={len(self.artists)}, "
            f"albums={len(self.albums)}, tracks={len(self.tracks)}, "
            f"full_refresh={self.full_refresh})"
        )
