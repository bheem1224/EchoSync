                self._update_progress(
                    playlist.name,
                    "Publishing download intents",
                    "",
                    70,
                    5,
                    4,
                    total_tracks=total_tracks,
                    matched_tracks=len(matched_tracks),
                    failed_tracks=len(unmatched_tracks),
                )
                downloaded_tracks = await self._publish_download_intents(
