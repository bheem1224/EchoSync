                INSERT OR REPLACE INTO parsed_tracks
                (raw_string, parsed_json, created_at, ttl_expires_at)
                VALUES (:key, :value, CURRENT_TIMESTAMP, :expires)
        Delete value from cache
        Args:
            key: Cache key
