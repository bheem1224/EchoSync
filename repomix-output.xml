                if !st.to_lowercase().contains(&ver.to_lowercase()) {
                    format!("{} ({})", st, ver)
                } else {
                    st.to_string()
                }
            } else {
                st.to_string()
            };
            tag.insert_text(ItemKey::TrackTitle, final_title);
        }
    }
    if let Some(ver) = version_str {
        tag.insert_text(ItemKey::TrackSubtitle, ver.to_string());
