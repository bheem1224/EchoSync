        """Returns a list of all available backups in the backups directory."""
        backups = []
        for file in self.backups_dir.glob("*.zip"):
            stat = file.stat()
            backups.append({
                "filename": file.name,
                "size_bytes": stat.st_size,
                "created_at": datetime.fromtimestamp(stat.st_ctime).isoformat()
            })
