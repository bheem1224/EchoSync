fn populate_tag_items(tag: &mut Tag, tags: &HashMap<String, String>) {
    let version_str = tags
        .get("version")
        .or_else(|| tags.get("subtitle"))
        .or_else(|| tags.get("edition"))
        .map(|s| s.trim())
        .filter(|s| !s.is_empty());
