                    CREATE TABLE IF NOT EXISTS track_aliases (
                        id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
                        track_id INTEGER NOT NULL,
                        plugin_id INTEGER,
                        name VARCHAR NOT NULL,
                        locale VARCHAR,
