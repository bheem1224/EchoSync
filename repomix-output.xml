            release_date=datetime.date(2013, 5, 17),
            mb_release_id="mb-release-ram-123",
        )
        session.add(album)
        session.flush()
        track_a = Track(
            title="Get Lucky",
            artist_id=artist.id,
            album_id=album.id,
            duration=248000,
            musicbrainz_id="mbid-get-lucky-daft-punk",
