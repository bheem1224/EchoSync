            album_title="In a Tidal Wave of Mystery",
            duration=343000,
            edition="Remix",
            media=[
                EchosyncMedia(
                    file_path="/music/Capital Cities/Safe and Sound (Remix).flac",
                    file_format="FLAC",
                )
            ],
        )
