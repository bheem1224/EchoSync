def create_discovery_pool_rows(tracks):
    rows = []
    for t in tracks:
        row_dict = {
            "spotify_track_id": t.get("id"),
            "track_name": t.get("name"),
            "artist_name": t.get("artist"),
            "album_name": t.get("album"),
