            # Try to match a registered plugin name ending with the string
            found = False
            for p_id, p_cls in PluginRegistry._plugins.items():
                if hasattr(p_cls, 'name') and p_cls.name and p_cls.name.lower().endswith(provider_id.lower()):
                    provider_id = p_id
