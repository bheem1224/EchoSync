        "track_number": track.track_number,
        "disc_number": track.disc_number,
        "bitrate": first_media.bitrate
        if first_media
        else getattr(track, "bitrate", None),
        "file_format": first_media.file_format
        if first_media
        else getattr(track, "file_format", None),
        "isrc": track.isrc,
