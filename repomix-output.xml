                distance -= 0.15
                if distance < 0.0:
                    distance = 0.0
            scored_tracks.append((distance, t))
        # Sort by distance (lowest is best)
        scored_tracks.sort(key=lambda x: x[0])
        top_tracks = scored_tracks[:limit]
        return [
            {
