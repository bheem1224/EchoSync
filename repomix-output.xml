        )
        result_accounts = []
        scoped_distribution = []
        for account in accounts:
            account_id = account["id"]
            account_name = account.get("display_name") or account.get("account_name") or "Unknown"
            total_suggestions = 0
            top_genres = []
            try:
                with working_db.session_scope() as work_session:
