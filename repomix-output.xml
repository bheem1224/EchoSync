        duration_weight = 1.0
        delta_sec = 0.0
        if cand_dur:
            try:
                cand_dur_val = float(cand_dur)
                if 0 < cand_dur_val < 10000:
                    cand_dur_val *= 1000.0
                cand_dur_ms = int(cand_dur_val)
                if file_duration_ms > 0:
                    track_dur_sec = file_duration_ms / 1000.0
                    cand_dur_sec = cand_dur_ms / 1000.0
