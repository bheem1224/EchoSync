    _NAMESPACE_COLORS = [
        '\033[38;5;39m',
        '\033[38;5;213m',
        '\033[38;5;46m',
        '\033[38;5;226m',
        '\033[38;5;208m',
        '\033[38;5;161m',
        '\033[38;5;198m',
        '\033[38;5;51m',
        '\033[38;5;220m',
